    {
      "id": "fd8aafb4-f668-405d-9275-1cc72d550b6a",
      "name": "Destinatários - Justificativa",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        -80
      ],
      "parameters": {
        "jsCode": "// ===== Representante comercial do bolsão (encerramento) =====\n// O responsável de cada bolsão vem da coluna \"Responsável\" da lista \"Matriz Bolsões\" (SharePoint).\n// O bolsão do encerramento vem da coluna \"Bolsão\" (linha \"Bolsão:\" do e-mail); se vier vazio, tenta pelo endereço.\nconst REPRESENTANTES = {\n  'exemplo1@exemplo.com':  '5511999999999',   // Responsável A\n  'exemplo2@exemplo.com': '5511999999999',   // Responsável B\n};\n// Recebe sempre. Também é o único destino quando o bolsão não é encontrado na Matriz.\nconst SEMPRE = [\n  '5511999999999',          // Responsável pela automação\n];\n// EM TESTE: true = cada representante é trocado pelo número de teste abaixo.\n// Para colocar em produção, troque para false.\nconst MODO_TESTE = true;\nconst NUMEROS_TESTE = {\n  'exemplo1@exemplo.com':  '5511999999999',   // bolsões do Responsável A → Responsável pela automação\n  'exemplo2@exemplo.com': '5511999999999',   // bolsões da Ana → Responsável pela automação\n};\n\nconst norm = s => ' ' + String(s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase()\n  .replace(/[^a-z0-9]+/g, ' ')\n  .replace(/\\b(rua|r|av|avenida|alameda|al|praca|travessa|estrada|bolsao)\\b/g, ' ')\n  .replace(/\\s+/g, ' ').trim() + ' ';\n\n// Procura o bolsão na Matriz (ignora acentos, maiúsculas e \"Rua\", \"Av.\" etc.)\nconst acharBolsao = (textos, matriz) => {\n  for (const t of textos) {\n    const alvo = norm(t);\n    if (alvo.trim().length < 3) continue;\n    const achados = (matriz || []).filter(b => {\n      const n = norm(b.Title);\n      return n.trim().length >= 3 && (alvo.includes(n) || n.includes(alvo));\n    });\n    if (achados.length) return achados.sort((a, b) => norm(b.Title).length - norm(a.Title).length)[0];\n  }\n  return null;\n};\n\nconst bolsaoDoItem = f => f.Bols_x00e3_o || f.Bolsao || '';\n\nconst representante = (f, resposta) => {\n  const lista = resposta && Array.isArray(resposta.value) ? resposta.value : null;\n  const b = lista ? acharBolsao([bolsaoDoItem(f), f.Title], lista) : null;\n  const resp = (b && b.Respons_x00e1_vel) || {};\n  const email = String(resp.EMail || '').toLowerCase();\n  const tel = MODO_TESTE ? NUMEROS_TESTE[email] : REPRESENTANTES[email];\n  let aviso = '';\n  if (!lista) aviso = 'Não foi possível consultar a Matriz Bolsões. Mensagem enviada só para o responsável pela automação.';\n  else if (!b) aviso = `Bolsão \"${bolsaoDoItem(f) || 'não informado'}\" não encontrado na Matriz Bolsões. Mensagem enviada só para o responsável pela automação.`;\n  else if (!tel) aviso = `Responsável \"${resp.Title || 'não preenchido'}\" do bolsão ${b.Title} sem WhatsApp cadastrado na automação.`;\n  if (MODO_TESTE && tel) aviso = `MODO TESTE – em produção esta mensagem iria para ${resp.Title} (${REPRESENTANTES[email] || 'sem número'}).`;\n  return {\n    bolsao: b ? b.Title : (bolsaoDoItem(f) || null),\n    representante: tel ? (resp.Title || null) : null,\n    responsavel: resp.Title || null,   // nome do responsável na Matriz (aparece na mensagem)\n    // em teste vai só para o número de teste do representante; em produção, representante + SEMPRE\n    numeros: MODO_TESTE ? (tel ? [tel] : SEMPRE) : (tel ? [tel] : []).concat(SEMPRE),\n    aviso,\n  };\n};\n\nconst valido = n => String(n).replace(/\\D/g, '');\nconst listaChat = arr => [...new Set(arr.map(valido).filter(n => n.length >= 12 && n.length <= 13))].map(n => n + '@c.us');\n\nconst matriz = $('Buscar Matriz Bolsões').first().json;\nconst item = $('Atualizar Status Comercial para Aguardando Observação').first().json;\nconst f = item.fields || {};\nconst r = representante(f, matriz);\n\n// ----- Padrão das mensagens (igual à adesão) -----\nconst dataBR = d => { if (!d) return 'Não informada'; const dt = DateTime.fromISO(String(d)).setZone('America/Sao_Paulo'); return dt.isValid ? dt.toFormat('dd/MM/yyyy') : String(d); };\nconst blocoEncerramento = (f, bolsao) => [\n  `🏘️ *Bolsão:* ${bolsao || f.Bols_x00e3_o || f.Bolsao || 'Não informado'}`,\n  '',\n  `👤 *Cliente:* ${f.NomedoCliente || 'Não informado'}`,\n  `📍 *Endereço:* ${f.Title || 'Não informado'}`,\n  `📞 *Telefone:* ${f.ContatodoCliente || 'Não informado'}`,\n  `📧 *E-mail:* ${f.E_x002d_MaildoCliente || 'Não informado'}`,\n  `📝 *Motivo:* ${f.Motivo || 'Não informado'}`,\n  `📅 *Data do encerramento:* ${dataBR(f.AvisoPrevio)}`,\n].join('\\n');\nconst texto = `📝 *JUSTIFICATIVA – COMERCIAL*\\n\\n${blocoEncerramento(f, r.bolsao)}`\n  + (r.aviso ? `\\n\\n⚠️ ${r.aviso}` : '')\n  + `\\n\\n📌 *Ação necessária:*\\nO cliente foi marcado como *não recuperado*. Informe o motivo pelo qual não foi possível recuperá-lo.\\n\\n✍️ Envie a justificativa nesta conversa.`;\nreturn listaChat(r.numeros).map(chatId => ({ json: { ...item, ...r, chatId, texto }, pairedItem: { item: 0 } }));\n"
      }
    },
    {
      "id": "4f6d87dc-6836-4665-a283-3705597415c1",
      "name": "E-mail - Cliente Recuperado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        -464
      ],
      "parameters": {
        "jsCode": "// ===== E-mail \"Cliente Recuperado\" para o Financeiro (padrão visual ASTER) =====\n// Quem envia o e-mail de encerramento é o Financeiro; ele é avisado quando o cliente é recuperado.\n// Cliente NÃO recuperado: nenhum e-mail.\nconst EMAIL_FINANCEIRO = 'exemplo3@exemplo.com';   // Faturamento (Financeiro)\n// EM TESTE: true = o e-mail vai para o e-mail de teste abaixo. Para produção, troque para false.\nconst MODO_TESTE = true;\nconst EMAIL_TESTE = 'exemplo4@exemplo.com';\n\nconst VERMELHO = '#c1291b';\nconst ESCURO = '#333333';\nconst CINZA = '#6b7280';\nconst BORDA = '#e5e7eb';\nconst VERDE = '#2e7d32';\nconst VERDE_CLARO = '#edf7ee';\nconst FONTE = \"'Segoe UI', Arial, Helvetica, sans-serif\";\n\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst data = (d, comHora) => {\n  if (!d) return 'Não informada';\n  const dt = DateTime.fromISO(String(d), { zone: 'utc' }).setZone('America/Sao_Paulo');\n  return dt.isValid ? dt.toFormat(comHora ? \"dd/MM/yyyy 'às' HH:mm\" : 'dd/MM/yyyy') : esc(d);\n};\n\nconst f = $('Atualizar item se for Recuperado').first().json.fields || {};\nconst cliente = f.NomedoCliente || 'Cliente';\nconst bolsao = f.Bols_x00e3_o || f.Bolsao || 'Não informado';\nconst email = f.E_x002d_MaildoCliente;\n\nconst linhaInfo = (rotulo, valor, destaque) => `\n<tr>\n  <td style=\"padding:9px 0;border-bottom:1px solid ${BORDA};font-family:${FONTE};font-size:13px;color:${CINZA};width:38%;\" valign=\"top\">${rotulo}</td>\n  <td style=\"padding:9px 0;border-bottom:1px solid ${BORDA};font-family:${FONTE};font-size:14px;color:${ESCURO};font-weight:${destaque ? 700 : 600};\" valign=\"top\">${valor}</td>\n</tr>`;\nconst titulo = t => `<div style=\"font-family:${FONTE};font-size:12px;font-weight:700;letter-spacing:1px;color:${VERMELHO};text-transform:uppercase;margin:26px 0 8px;\">${t}</div>`;\n\nconst avisoTeste = MODO_TESTE ? `\n  <tr><td style=\"padding:20px 32px 0;\">\n    <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr>\n      <td bgcolor=\"#fff8e1\" style=\"padding:10px 14px;border:1px dashed #f0b429;border-radius:6px;font-family:${FONTE};font-size:12px;color:#7a5a00;\">\n        <b>MODO TESTE</b> – em produção este e-mail iria para ${esc(EMAIL_FINANCEIRO)}.\n      </td>\n    </tr></table>\n  </td></tr>` : '';\n\nconst html = `<!DOCTYPE html><html lang=\"pt-BR\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width\"></head>\n<body style=\"margin:0;padding:0;background:#f3f4f6;\">\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#f3f4f6\"><tr><td align=\"center\" style=\"padding:28px 12px;\">\n<table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width:600px;max-width:600px;background:#ffffff;border-radius:8px;overflow:hidden;border:1px solid ${BORDA};\">\n\n  <!-- Cabeçalho -->\n  <tr><td bgcolor=\"${VERMELHO}\" style=\"padding:22px 32px;\">\n    <div style=\"font-family:${FONTE};font-size:20px;font-weight:800;letter-spacing:3px;color:#ffffff;\">GRUPO ASTER</div>\n    <div style=\"font-family:${FONTE};font-size:13px;color:#fde2df;margin-top:2px;\">Encerramento de Cliente &nbsp;·&nbsp; Financeiro</div>\n  </td></tr>\n${avisoTeste}\n  <!-- Selo -->\n  <tr><td align=\"center\" style=\"padding:30px 32px 0;\">\n    <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" align=\"center\"><tr>\n      <td width=\"56\" height=\"56\" align=\"center\" valign=\"middle\" bgcolor=\"${VERDE}\"\n          style=\"width:56px;height:56px;border-radius:28px;font-family:${FONTE};font-size:28px;font-weight:700;color:#ffffff;\">&#10003;</td>\n    </tr></table>\n    <div style=\"font-family:${FONTE};font-size:12px;font-weight:700;letter-spacing:1px;color:${VERDE};text-transform:uppercase;margin-top:14px;\">Encerramento cancelado</div>\n    <div style=\"font-family:${FONTE};font-size:24px;font-weight:700;color:${ESCURO};margin:4px 0 0;\">Cliente recuperado</div>\n    <div style=\"font-family:${FONTE};font-size:14px;color:${CINZA};margin-top:6px;\">${esc(cliente)} &nbsp;·&nbsp; Bolsão ${esc(bolsao)}</div>\n  </td></tr>\n\n  <!-- Chamada -->\n  <tr><td style=\"padding:22px 32px 0;\">\n    <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr>\n      <td width=\"4\" bgcolor=\"${VERDE}\" style=\"width:4px;\"></td>\n      <td bgcolor=\"${VERDE_CLARO}\" style=\"padding:14px 16px;font-family:${FONTE};font-size:14px;line-height:21px;color:${ESCURO};\">\n        O cliente da solicitação de encerramento enviada por você foi <b style=\"color:${VERDE};\">recuperado</b> e continua com o serviço.\n      </td>\n    </tr></table>\n  </td></tr>\n\n  <!-- Dados -->\n  <tr><td style=\"padding:0 32px 28px;\">\n    ${titulo('Dados do cliente')}\n    <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n      ${linhaInfo('Nome do cliente', esc(cliente), true)}\n      ${linhaInfo('Bolsão', esc(bolsao))}\n      ${linhaInfo('Endereço', esc(f.Title || 'Não informado'))}\n      ${linhaInfo('Telefone', esc(f.ContatodoCliente || 'Não informado'))}\n      ${linhaInfo('E-mail', email ? `<a href=\"mailto:${esc(email)}\" style=\"color:${VERMELHO};text-decoration:none;\">${esc(email)}</a>` : 'Não informado')}\n    </table>\n\n    ${titulo('Solicitação de encerramento')}\n    <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n      ${linhaInfo('Motivo informado', esc(f.Motivo || 'Não informado'))}\n      ${linhaInfo('Data do encerramento', data(f.AvisoPrevio))}\n      ${linhaInfo('Recuperado em', data(f.DataRespostaComercial || DateTime.now().toISO(), true), true)}\n    </table>\n  </td></tr>\n\n  <!-- Rodapé -->\n  <tr><td bgcolor=\"#f9fafb\" style=\"padding:16px 32px;border-top:1px solid ${BORDA};font-family:${FONTE};font-size:11px;line-height:17px;color:${CINZA};\">\n    Mensagem automática da Automação de Encerramento de Clientes — Grupo ASTER. Não responda este e-mail.\n  </td></tr>\n\n</table>\n</td></tr></table>\n</body></html>`;\n\nreturn [{ json: {\n  para: MODO_TESTE ? EMAIL_TESTE : EMAIL_FINANCEIRO,\n  assunto: `✅ Cliente Recuperado – ${cliente} (${bolsao})`,\n  corpo: html,\n} }];\n"
      }
    },
    {
