    {
      "id": "ae99ea42-ca91-448b-9b88-5e5df961afd6",
      "name": "Montar Mensagens - Encerramento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        48
      ],
      "parameters": {
        "jsCode": "\n// ----- Padrão das mensagens (igual à adesão) -----\nconst dataBR = d => { if (!d) return 'Não informada'; const dt = DateTime.fromISO(String(d)).setZone('America/Sao_Paulo'); return dt.isValid ? dt.toFormat('dd/MM/yyyy') : String(d); };\nconst blocoEncerramento = (f, bolsao) => [\n  `🏘️ *Bolsão:* ${bolsao || f.Bols_x00e3_o || f.Bolsao || 'Não informado'}`,\n  '',\n  `👤 *Cliente:* ${f.NomedoCliente || 'Não informado'}`,\n  `📍 *Endereço:* ${f.Title || 'Não informado'}`,\n  `📞 *Telefone:* ${f.ContatodoCliente || 'Não informado'}`,\n  `📧 *E-mail:* ${f.E_x002d_MaildoCliente || 'Não informado'}`,\n  `📝 *Motivo:* ${f.Motivo || 'Não informado'}`,\n  `📅 *Data do encerramento:* ${dataBR(f.AvisoPrevio)}`,\n].join('\\n');\n\n// Dados do item (resposta do SharePoint); se faltar, usa o que veio na chamada\nconst e = $('Entrada Operacional').first().json;\nconst f = Object.assign({ NomedoCliente: e.nomeCliente, Title: e.endereco, ContatodoCliente: e.telefone,\n  E_x002d_MaildoCliente: e.email, Motivo: e.motivo, AvisoPrevio: e.avisoPrevio, Bols_x00e3_o: e.bolsao },\n  $('Update item in a list').first().json.fields || {});\nconst montar = (area, acao) => ({\n  detalhes: `🚨 *ENCERRAMENTO DE CLIENTE – ${area}*\\n\\n${blocoEncerramento(f)}`,\n  enquete: `📌 Ação necessária:\\n${acao}`.slice(0, 255),\n});\nreturn [{ json: {\n  operacional: montar('OPERACIONAL', 'Retirar a placa da residência do cliente.'),\n  sistemas: montar('SISTEMAS', 'Retirar o cliente de todos os sistemas.'),\n} }];\n"
      }
    },
