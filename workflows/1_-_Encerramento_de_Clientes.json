        "jsCode": "// ===== Representante comercial do bolsão (encerramento) =====\n// O responsável de cada bolsão vem da coluna \"Responsável\" da lista \"Matriz Bolsões\" (SharePoint).\n// O bolsão do encerramento vem da coluna \"Bolsão\" (linha \"Bolsão:\" do e-mail); se vier vazio, tenta pelo endereço.\nconst REPRESENTANTES = {\n  'exemplo1@exemplo.com':  '5511999999999',   // Responsável A\n  'exemplo2@exemplo.com': '5511999999999',   // Responsável B\n};\n// Recebe sempre. Também é o único destino quando o bolsão não é encontrado na Matriz.\nconst SEMPRE = [\n  '5511999999999',          // Responsável pela automação\n];\n// EM TESTE: true = cada representante é trocado pelo número de teste abaixo.\n// Para colocar em produção, troque para false.\nconst MODO_TESTE = true;\nconst NUMEROS_TESTE = {\n  'exemplo1@exemplo.com':  '5511999999999',   // bolsões do Responsável A → Responsável pela automação\n  'exemplo2@exemplo.com': '5511999999999',   // bolsões da Ana → Responsável pela automação\n};\n\nconst norm = s => ' ' + String(s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase()\n  .replace(/[^a-z0-9]+/g, ' ')\n  .replace(/\\b(rua|r|av|avenida|alameda|al|praca|travessa|estrada|bolsao)\\b/g, ' ')\n  .replace(/\\s+/g, ' ').trim() + ' ';\n\n// Procura o bolsão na Matriz (ignora acentos, maiúsculas e \"Rua\", \"Av.\" etc.)\nconst acharBolsao = (textos, matriz) => {\n  for (const t of textos) {\n    const alvo = norm(t);\n    if (alvo.trim().length < 3) continue;\n    const achados = (matriz || []).filter(b => {\n      const n = norm(b.Title);\n      return n.trim().length >= 3 && (alvo.includes(n) || n.includes(alvo));\n    });\n    if (achados.length) return achados.sort((a, b) => norm(b.Title).length - norm(a.Title).length)[0];\n  }\n  return null;\n};\n\nconst bolsaoDoItem = f => f.Bols_x00e3_o || f.Bolsao || '';\n\nconst representante = (f, resposta) => {\n  const lista = resposta && Array.isArray(resposta.value) ? resposta.value : null;\n  const b = lista ? acharBolsao([bolsaoDoItem(f), f.Title], lista) : null;\n  const resp = (b && b.Respons_x00e1_vel) || {};\n  const email = String(resp.EMail || '').toLowerCase();\n  const tel = MODO_TESTE ? NUMEROS_TESTE[email] : REPRESENTANTES[email];\n  let aviso = '';\n  if (!lista) aviso = 'Não foi possível consultar a Matriz Bolsões. Mensagem enviada só para o responsável pela automação.';\n  else if (!b) aviso = `Bolsão \"${bolsaoDoItem(f) || 'não informado'}\" não encontrado na Matriz Bolsões. Mensagem enviada só para o responsável pela automação.`;\n  else if (!tel) aviso = `Responsável \"${resp.Title || 'não preenchido'}\" do bolsão ${b.Title} sem WhatsApp cadastrado na automação.`;\n  if (MODO_TESTE && tel) aviso = `MODO TESTE – em produção esta mensagem iria para ${resp.Title} (${REPRESENTANTES[email] || 'sem número'}).`;\n  return {\n    bolsao: b ? b.Title : (bolsaoDoItem(f) || null),\n    representante: tel ? (resp.Title || null) : null,\n    responsavel: resp.Title || null,   // nome do responsável na Matriz (aparece na mensagem)\n    // em teste vai só para o número de teste do representante; em produção, representante + SEMPRE\n    numeros: MODO_TESTE ? (tel ? [tel] : SEMPRE) : (tel ? [tel] : []).concat(SEMPRE),\n    aviso,\n  };\n};\n\nconst valido = n => String(n).replace(/\\D/g, '');\nconst listaChat = arr => [...new Set(arr.map(valido).filter(n => n.length >= 12 && n.length <= 13))].map(n => n + '@c.us');\n\n\n// ----- Padrão das mensagens (igual à adesão) -----\nconst dataBR = d => { if (!d) return 'Não informada'; const dt = DateTime.fromISO(String(d)).setZone('America/Sao_Paulo'); return dt.isValid ? dt.toFormat('dd/MM/yyyy') : String(d); };\nconst blocoEncerramento = (f, bolsao) => [\n  `🏘️ *Bolsão:* ${bolsao || f.Bols_x00e3_o || f.Bolsao || 'Não informado'}`,\n  '',\n  `👤 *Cliente:* ${f.NomedoCliente || 'Não informado'}`,\n  `📍 *Endereço:* ${f.Title || 'Não informado'}`,\n  `📞 *Telefone:* ${f.ContatodoCliente || 'Não informado'}`,\n  `📧 *E-mail:* ${f.E_x002d_MaildoCliente || 'Não informado'}`,\n  `📝 *Motivo:* ${f.Motivo || 'Não informado'}`,\n  `📅 *Data do encerramento:* ${dataBR(f.AvisoPrevio)}`,\n].join('\\n');\n\n// Uma mensagem de detalhes + uma enquete curta por destinatário (padrão da adesão)\nconst matriz = $('Buscar Matriz Bolsões').first().json;\nconst saida = [];\n$('Atualizar Item para Aguardando Comercial').all().forEach(item => {\n  const f = item.json.fields || {};\n  const r = representante(f, matriz);\n  const prazo = dataBR(f.DataLimiteComercial || DateTime.now().plus({ days: 15 }).toISO());\n  const acao = `Tentar recuperar o cliente até ${prazo}.`;\n  const detalhes = `🚨 *ENCERRAMENTO DE CLIENTE – COMERCIAL*\\n\\n${blocoEncerramento(f, r.bolsao)}` + (r.aviso ? `\\n\\n⚠️ ${r.aviso}` : '');\n  const nomeEnquete = `📌 Ação necessária:\\n${acao}`.slice(0, 255);\n  listaChat(r.numeros).forEach(chatId => saida.push({\n    json: { ...item.json, ...r, chatId, detalhes, nomeEnquete, itemIdSharePoint: String(item.json.id) },\n    pairedItem: { item: 0 },\n  }));\n});\nreturn saida;\n"
      }
    },
