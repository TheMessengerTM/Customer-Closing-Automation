      "parameters": {
        "jsCode": "// ===== Representante comercial do bolsão (encerramento) =====\n// O responsável de cada bolsão vem da coluna \"Responsável\" da lista \"Matriz Bolsões\" (SharePoint).\n// O bolsão do encerramento vem da coluna \"Bolsão\" (linha \"Bolsão:\" do e-mail); se vier vazio, tenta pelo endereço.\nconst REPRESENTANTES = {\n  'exemplo1@exemplo.com':  '5511999999999',   // Responsável A\n  'exemplo2@exemplo.com': '5511999999999',   // Responsável B\n};\n// Recebe sempre. Também é o único destino quando o bolsão não é encontrado na Matriz.\nconst SEMPRE = [\n  '5511999999999',          // Responsável pela automação\n];\n// EM TESTE: true = cada representante é trocado pelo número de teste abaixo.\n// Para colocar em produção, troque para false.\nconst MODO_TESTE = true;\nconst NUMEROS_TESTE = {\n  'exemplo1@exemplo.com':  '5511999999999',   // bolsões do Responsável A → Responsável pela automação\n  'exemplo2@exemplo.com': '5511999999999',   // bolsões da Ana → Responsável pela automação\n};\n\nconst norm = s => ' ' + String(s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase()\n  .replace(/[^a-z0-9]+/g, ' ')\n  .replace(/\\b(rua|r|av|avenida|alameda|al|praca|travessa|estrada|bolsao)\\b/g, ' ')\n  .replace(/\\s+/g, ' ').trim() + ' ';\n\n// Procura o bolsão na Matriz (ignora acentos, maiúsculas e \"Rua\", \"Av.\" etc.)\nconst acharBolsao = (textos, matriz) => {\n  for (const t of textos) {\n    const alvo = norm(t);\n    if (alvo.trim().length < 3) continue;\n    const achados = (matriz || []).filter(b => {\n      const n = norm(b.Title);\n      return n.trim().length >= 3 && (alvo.includes(n) || n.includes(alvo));\n    });\n    if (achados.length) return achados.sort((a, b) => norm(b.Title).length - norm(a.Title).length)[0];\n  }\n  return null;\n};\n\nconst bolsaoDoItem = f => f.Bols_x00e3_o || f.Bolsao || '';\n\nconst representante = (f, resposta) => {\n  const lista = resposta && Array.isArray(resposta.value) ? resposta.value : null;\n  const b = lista ? acharBolsao([bolsaoDoItem(f), f.Title], lista) : null;\n  const resp = (b && b.Respons_x00e1_vel) || {};\n  const email = String(resp.EMail || '').toLowerCase();\n  const tel = MODO_TESTE ? NUMEROS_TESTE[email] : REPRESENTANTES[email];\n  let aviso = '';\n  if (!lista) aviso = 'Não foi possível consultar a Matriz Bolsões. Mensagem enviada só para o responsável pela automação.';\n  else if (!b) aviso = `Bolsão \"${bolsaoDoItem(f) || 'não informado'}\" não encontrado na Matriz Bolsões. Mensagem enviada só para o responsável pela automação.`;\n  else if (!tel) aviso = `Responsável \"${resp.Title || 'não preenchido'}\" do bolsão ${b.Title} sem WhatsApp cadastrado na automação.`;\n  if (MODO_TESTE && tel) aviso = `MODO TESTE – em produção esta mensagem iria para ${resp.Title} (${REPRESENTANTES[email] || 'sem número'}).`;\n  return {\n    bolsao: b ? b.Title : (bolsaoDoItem(f) || null),\n    representante: tel ? (resp.Title || null) : null,\n    // em teste vai só para o número de teste do representante; em produção, representante + SEMPRE\n    numeros: MODO_TESTE ? (tel ? [tel] : SEMPRE) : (tel ? [tel] : []).concat(SEMPRE),\n    aviso,\n  };\n};\n\nconst valido = n => String(n).replace(/\\D/g, '');\nconst listaChat = arr => [...new Set(arr.map(valido).filter(n => n.length >= 12 && n.length <= 13))].map(n => n + '@c.us');\n\n// Escolhe o cliente que vai receber a justificativa.\n// - Veio do Lists (itemIdDireto): usa exatamente esse item, se ainda estiver pendente.\n// - Veio do WhatsApp: usa o pendente mais antigo desta área.\nconst e = $('Edit Fields').first().json;\nlet pend = $input.all().map(i => i.json)\n  .filter(j => j && j.id && j.fields && j.fields.StatusComercial === 'Aguardando Observação');\n// Veio do WhatsApp: só os clientes dos bolsões de quem respondeu (o Responsável pela automação vê os sem responsável)\nif (!e.itemIdDireto) {\n  const matriz = $('Buscar Matriz Bolsões').first().json;\n  const tel = valido(e.telefone);\n  pend = pend.filter(j => representante(j.fields, matriz).numeros.map(valido).includes(tel));\n}\nif (!pend.length) return [];\nlet alvo;\nif (e.itemIdDireto) {\n  alvo = pend.find(j => String(j.id) === String(e.itemIdDireto));\n} else {\n  const data = j => new Date(j.fields.DataRespostaComercial || j.fields.Modified || 0).getTime();\n  alvo = pend.sort((a, b) => data(a) - data(b))[0];\n}\nif (!alvo) return [];\nreturn [{ json: {\n  itemIdSharePoint: String(alvo.id),\n  cliente: alvo.fields.NomedoCliente || '',\n  endereco: alvo.fields.Title || '',\n  restantes: pend.length - 1\n} }];"
      }
    },
