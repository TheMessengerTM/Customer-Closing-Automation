    {
      "parameters": {
        "jsCode": "// Escolhe o cliente que vai receber a justificativa.\n// - Veio do Lists (itemIdDireto): usa exatamente esse item, se ainda estiver pendente.\n// - Veio do WhatsApp: usa o pendente mais antigo desta área.\nconst e = $('Edit Fields').first().json;\nconst pend = $input.all().map(i => i.json)\n  .filter(j => j && j.id && j.fields && j.fields.StatusComercial === 'Aguardando Observação');\nif (!pend.length) return [];\nlet alvo;\nif (e.itemIdDireto) {\n  alvo = pend.find(j => String(j.id) === String(e.itemIdDireto));\n} else {\n  const data = j => new Date(j.fields.DataRespostaComercial || j.fields.Modified || 0).getTime();\n  alvo = pend.sort((a, b) => data(a) - data(b))[0];\n}\nif (!alvo) return [];\nreturn [{ json: {\n  itemIdSharePoint: String(alvo.id),\n  cliente: alvo.fields.NomedoCliente || '',\n  endereco: alvo.fields.Title || '',\n  restantes: pend.length - 1\n} }];"
      },
