    {
      "id": "8b9f2716-af30-424d-9ac0-534910bfc96b",
      "name": "Extrair Dados do Encerramento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        -192
      ],
      "parameters": {
        "jsCode": "const html = $json.body?.content || '';\n\n// Converte o HTML do Outlook em texto simples\nconst texto = html\n  .replace(/<br\\s*\\/?>/gi, '\\n')\n  .replace(/<\\/p>/gi, '\\n')\n  .replace(/<[^>]+>/g, '')\n  .replace(/&nbsp;/gi, ' ')\n  .replace(/&amp;/gi, '&')\n  .replace(/&lt;/gi, '<')\n  .replace(/&gt;/gi, '>')\n  .replace(/&quot;/gi, '\"')\n  .replace(/&#39;|&apos;/gi, \"'\")\n  .replace(/\\r/g, '')\n  .split('\\n')\n  .map(linha => linha.trim())\n  .filter(Boolean)\n  .join('\\n');\n\nfunction escapeRegex(texto) {\n  return texto.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n}\n\nfunction extrair(label) {\n  const regex = new RegExp(\n    `^${escapeRegex(label)}\\\\s*(.+)$`,\n    'im'\n  );\n\n  const resultado = texto.match(regex);\n\n  return resultado ? resultado[1].trim() : '';\n}\n\nconst bolsao = extrair('Bolsão:') || extrair('Bolsao:');\nconst dataEncerramento = extrair('Data do Encerramento:');\nconst nomeCliente = extrair('Nome do Cliente:');\nconst endereco = extrair('Endereço:');\nconst telefone = extrair('Telefone:');\nconst email = extrair('E-mail:');\nconst motivo = extrair('Motivo:');\n\n// Converte DD/MM/AAAA para AAAA-MM-DD\nlet avisoPrevio = '';\n\nif (/^\\d{2}\\/\\d{2}\\/\\d{4}$/.test(dataEncerramento)) {\n  const [dia, mes, ano] = dataEncerramento.split('/');\n  avisoPrevio = `${ano}-${mes}-${dia}`;\n}\n\nconst faltando = [];\n\nif (!dataEncerramento) faltando.push('Data do Encerramento');\nif (!nomeCliente) faltando.push('Nome do Cliente');\nif (!endereco) faltando.push('Endereço');\nif (!telefone) faltando.push('Telefone');\nif (!email) faltando.push('E-mail');\nif (!motivo) faltando.push('Motivo');\nif (dataEncerramento && !avisoPrevio) faltando.push('Data do Encerramento em formato inválido (use DD/MM/AAAA)');\n\nreturn {\n  json: {\n    emailId: $json.id,\n    assunto: $json.subject,\n    remetente: $json.from?.emailAddress?.address || '',\n    \n    bolsao,\n    dataEncerramento,\n    avisoPrevio,\n    nomeCliente,\n    endereco,\n    telefone,\n    email,\n    motivo,\n\n    valido: faltando.length === 0,\n    camposFaltantes: faltando\n  }\n};"
      }
    },
